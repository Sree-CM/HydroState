# Wapaba model function
wapaba_model <- function(data,params) {
##########This is for testing
# Create an empty dataframe to store intermediate values
#results <- data.frame( Row = integer(),X = numeric(), Xp = numeric(), Y = numeric(),W=numeric(),R= numeric(), Qs = numeric(), Qb = numeric(),F1=numeric(),F2=numeric())
#results <- data.frame(matrix(, ncol = 9))
#colnames(results) <- c("x", "Xp", "Y","W","R","Qs", "Qb","F1","F2")
##################
# Extract individual parameters correctly
alpha1 <- params[1]
alpha2 <- params[2]
beta <- params[3]
Smax <- params[4]
tc = params[5] # Time constant which is equal to 1/k in the original paper
# Extract columns inside function. This is for normal case
# P <- data$P
# ETo <- data$ETo
#compatible with hydrostate naming convention
P <- data$precipitation
ETo <- data$evap
# Initialize storage variables
# n_timesteps <- length(data$P) # Number of time steps from length of the input data (e.g., days)
n_timesteps <- length(data$precipitation) # Number of time steps from length of the input data (e.g., days) . For Paper 3
S <- numeric(n_timesteps) # Soil water store (mm)
G <- numeric(n_timesteps) # Groundwater store (mm)
S[1] <- 100 # Initial soil water storage (mm) - You'll need to set an initial value
G[1] <- 50  # Initial groundwater storage (mm) - You'll need to set an initial value
# Initialize flux variables
X <- numeric(n_timesteps) # Catchment water consumption (mm)
Xp <- numeric(n_timesteps)
Y <- numeric(n_timesteps) # Catchment water yield (mm)
W <- numeric(n_timesteps) # Water available for evapotranspiration (mm)
ET <- numeric(n_timesteps) # Actual evapotranspiration (mm)
R <- numeric(n_timesteps) # Recharge to groundwater (mm)
Qs <- numeric(n_timesteps) # Surface runoff (mm)
Qb <- numeric(n_timesteps) # Base flow (mm)
Q <- numeric(n_timesteps)
F1 <- numeric(n_timesteps)
F2 <- numeric(n_timesteps)
# Time step loop
#for (t in 1:n_timesteps)
for (t in 1:n_timesteps) {
# Stage 1: Catchment water consumption and yield
if(t==1){
#S[t-1] = 0.5*Smax
Xp[t] = ETo[t] + (Smax - 0.5*Smax)
}else{
Xp[t] = ETo[t] + (Smax - S[t-1])
}
#print(paste("X0 value for time",t, Xp[t]) )
#print(paste("Year of fire is  ", fire.year))
F1[t] = 1+P[t]/Xp[t] - (1+(P[t]/Xp[t])^alpha1)^(1/alpha1)
#print(paste("F1 value for time",t, F1[t]) )
X[t] <- Xp[t] * F1[t]
#print(paste("X(t) value for time",t, X[t]) )
Y[t] <- P[t] - X[t]
#print(paste("Y(t) value for time",t, Y[t]) )
# Stage 2: Actual evapotranspiration and soil water storage
if(t==1){
#   #S[t-1] = 0.5*Smax
W[t] =0.5*Smax + X[t]
}else{
W[t] <- S[t-1] + X[t]
}
F2[t] = 1+W[t]/ETo[t] - (1+(W[t]/ETo[t])^alpha2)^(1/alpha2)
ET[t] <- ETo[t] * F2[t]
S[t] <- W[t] - ET[t]
#print(paste("S(t) value for time",t, S[t] ) )
#print(paste("W[t] value for time",t, W[t] ) )
# Stage 3: Recharge and surface runoff
R[t] <- beta * Y[t]
Qs[t] <- Y[t] - R[t]
#print(paste("Qs(t) value for time",t, Qs[t]) )
#print(paste("R value for time",t, R[t]) )
# Stage 4: Base flow from groundwater
T <- 1 # Time step length (e.g., 1 day) - Adjust if needed
if(t==1){
#   #S[t-1] = 0.5*Smax
Qb[t] <- 1 * (1 - exp(-T*30 *tc)) + R[t] * (1 - (1 / (tc*T*30)) * (1 - exp(-T*30 *tc))) # Here multiplied by 30 is done to convert the timestep T to no.of days as K is in day.
G[t] <- 1 + R[t] - Qb[t] # Update groundwater storage
}else{
Qb[t] <- G[t-1] * (1 - exp(-T*30*tc)) + R[t] * (1 - ((1/ (tc*30*T)) * (1 - exp(-30*T * tc))))
G[t] <- G[t-1] + R[t] - Qb[t] # Update groundwater storage
}
#print(paste("Qb(t) value for time",t, Qb[t]) )
#Stage 5 - total flow= baseflow+surface runoff
Q[t] = Qs[t] + Qb[t]
#####temporary
#results[t,] <- c( X[t],  Xp[t],  Y[t],W[t],R[t], Qs[t],Qb[t],F1[t],F2[t])
# Save intermediate values to CSV
#write.csv(results, "wapaba_intermediate_results.csv", row.names = FALSE)
#############
}
# Return the full time series after the loop
return(Q)
}
